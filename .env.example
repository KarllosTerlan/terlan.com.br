# ============================================================
# Clinic Bot - Environment Variables
# ============================================================

# ---------- Deploy / Domain ----------
DOMAIN=example.com
ACME_EMAIL=admin@example.com

# ---------- Node / API ----------
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# ---------- Auth ----------
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---------- Database ----------
POSTGRES_USER=clinic
POSTGRES_PASSWORD=clinic_strong_password
POSTGRES_DB=clinic_bot
DATABASE_URL=postgresql://clinic:clinic_strong_password@postgres:5432/clinic_bot?schema=public

# ---------- Redis ----------
REDIS_URL=redis://redis:6379

# ---------- Anthropic Claude ----------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-5
CLAUDE_MAX_TOKENS=1024

# ---------- Google Calendar OAuth ----------
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx
GOOGLE_REDIRECT_URI=https://api.example.com/google/callback

# ---------- WhatsApp Evolution API (primary, self-hosted) ----------
# URL interna do serviço evolution na rede docker.
EVOLUTION_API_URL=http://evolution:8080
# API key global do Evolution (header `apikey`). Use uma string longa e aleatória em produção.
EVOLUTION_API_KEY=change-me-evolution-strong-key
# Token usado para validar webhooks de entrada do Evolution (geralmente igual à API key).
EVOLUTION_WEBHOOK_TOKEN=change-me-evolution-strong-key

# ---------- WhatsApp Cloud API (Meta — fallback) ----------
# Permanent token from your Meta App (System User > Generate Token).
WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Phone Number ID shown in the Meta panel under WhatsApp > API Setup.
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Verify token: any string you choose; must match what you set when adding the webhook in Meta.
WHATSAPP_VERIFY_TOKEN=clinic-bot-verify-token-change-me
# WABA (WhatsApp Business Account) id — optional, used for diagnostics only.
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Graph API version used in calls.
WHATSAPP_API_VERSION=v19.0

# ---------- Frontend ----------
FRONTEND_URL=https://app.example.com
VITE_API_URL=https://api.example.com
# Public URL of the API (used to show the webhook URL in the panel).
PUBLIC_API_URL=https://api.example.com

# ---------- Behavior ----------
RATE_LIMIT_MS=2000
REMINDER_LEAD_MINUTES=60
CONVERSATION_RETENTION_DAYS=30
